{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://voiceroom.local/schemas/g19-physical-matrix.schema.json",
  "title": "VoiceRoom 2.5.0 G19 physical support matrix",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "release", "capturedFor", "implementer", "rows"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "release": { "const": "2.5.0" },
    "capturedFor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gitSha", "buildVersion"],
      "properties": {
        "gitSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "buildVersion": { "type": "string", "minLength": 1, "maxLength": 100 }
      }
    },
    "implementer": { "$ref": "#/$defs/actor" },
    "rows": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": { "$ref": "#/$defs/row" }
    }
  },
  "$defs": {
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "displayName"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9._@:-]{3,100}$" },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 100 }
      }
    },
    "versionedProduct": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 100 },
        "version": { "type": "string", "minLength": 1, "maxLength": 100 }
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["deviceIdHash", "clientProfileIdHash"],
      "properties": {
        "deviceIdHash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "clientProfileIdHash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "desktopInstallIdHash": { "type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$" }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "uri", "sha256", "independentlyStored"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9._:/-]{8,200}$" },
        "uri": { "type": "string", "format": "uri" },
        "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "independentlyStored": { "const": true }
      }
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform", "os", "client", "capturedAt", "expected", "observed", "zeroSideEffects", "accessibility", "notification", "identity", "artifact", "reviewer"],
      "properties": {
        "platform": { "enum": ["ios-safari", "android-chrome", "ipados-safari", "desktop-chrome", "desktop-firefox", "desktop-safari", "voiceroom-desktop"] },
        "os": { "$ref": "#/$defs/versionedProduct" },
        "client": { "$ref": "#/$defs/versionedProduct" },
        "capturedAt": { "type": "string", "format": "date-time" },
        "expected": { "enum": ["blocked", "allowed"] },
        "observed": { "enum": ["blocked", "allowed"] },
        "zeroSideEffects": { "type": "boolean" },
        "accessibility": {
          "type": "object",
          "additionalProperties": false,
          "required": ["focus", "name", "layout"],
          "properties": {
            "focus": { "const": "pass" },
            "name": { "const": "pass" },
            "layout": { "const": "pass" }
          }
        },
        "notification": {
          "type": "object",
          "additionalProperties": false,
          "required": ["permission", "serviceWorker", "visibility", "shown"],
          "properties": {
            "permission": { "enum": ["default", "denied", "granted", "not-applicable"] },
            "serviceWorker": { "enum": ["unregistered", "registered", "not-applicable"] },
            "visibility": { "enum": ["foreground", "background", "closed", "not-applicable"] },
            "shown": { "type": "boolean" }
          }
        },
        "identity": { "$ref": "#/$defs/identity" },
        "artifact": { "$ref": "#/$defs/artifact" },
        "reviewer": { "$ref": "#/$defs/actor" }
      }
    }
  }
}
