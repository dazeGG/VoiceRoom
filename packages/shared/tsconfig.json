{
  // Shared contracts are strict TypeScript run as-is: Node 24 strips the
  // types for the API, Vite compiles them for the web. Only erasable syntax,
  // nothing emitted. No Node types: the same code runs in the browser, so a
  // bare `process` or `Buffer` must not type-check. See docs/ARCHITECTURE.md.
  "compilerOptions": {
    "target": "es2023",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": ["es2023", "dom"],
    "types": [],
    "allowJs": true,
    "checkJs": false,
    "resolveJsonModule": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/*.d.ts"]
}
