{
  "name": "@voice-room/shared",
  "version": "2.4.2",
  "private": true,
  "type": "commonjs",
  "exports": {
    "./validation": {
      "types": "./src/validation.d.ts",
      "require": "./src/validation.js"
    },
    "./realtime": {
      "types": "./src/realtime.d.ts",
      "require": "./src/realtime.js"
    },
    "./avatar-accent": {
      "types": "./src/avatar-accent.d.ts",
      "import": "./src/avatar-accent.mjs",
      "require": "./src/avatar-accent.js"
    },
    "./emoji": {
      "types": "./src/emoji.d.ts",
      "import": "./src/emoji.mjs",
      "require": "./src/emoji.js"
    },
    "./visual-identity": {
      "types": "./src/visual-identity.d.ts",
      "import": "./src/visual-identity.mjs",
      "require": "./src/visual-identity.json"
    }
  },
  "scripts": {
    "check": "node --check src/validation.js && node --check src/realtime.js && node --check src/avatar-accent.js && node --check src/avatar-accent.mjs && node --check src/emoji.js && node --check src/emoji.mjs",
    "test": "node --test test/*.test.js"
  }
}
