{
  "name": "voice-room",
  "version": "2.6.4",
  "private": true,
  "description": "Simple link-based LiveKit voice chat with screen sharing.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "start": "docker compose up -d --build",
    "stop": "docker compose down",
    "logs": "docker compose logs -f",
    "dev": "docker compose -f docker-compose.dev.yml up --build",
    "dev:up": "docker compose -f docker-compose.dev.yml up -d --build",
    "dev:down": "docker compose -f docker-compose.dev.yml down",
    "dev:logs": "docker compose -f docker-compose.dev.yml logs -f",
    "dev:restart": "docker compose -f docker-compose.dev.yml restart livekit-gate api web",
    "dev:api": "docker compose -f docker-compose.dev.yml up --build api",
    "dev:web": "docker compose -f docker-compose.dev.yml up --build web",
    "dev:livekit": "docker compose -f docker-compose.dev.yml up --build livekit-gate",
    "dev:host:api": "npm --workspace @voice-room/api run dev",
    "dev:host:web": "npm --workspace @voice-room/web run dev",
    "dev:host:livekit": "docker run --rm -e LIVEKIT_KEYS=\"devkey: devsecret\" -p 7880:7880 -p 7881:7881 -p 7882:7882/udp livekit/livekit-server:v1.13.2 --dev --bind 0.0.0.0",
    "build": "npm --workspace @voice-room/web run build",
    "check": "npm --workspace @voice-room/shared run check && npm --workspace @voice-room/api run check && npm --workspace @voice-room/web run check && tsc -p scripts/tsconfig.json && npm run lint",
    "lint": "eslint . --cache --cache-location node_modules/.cache/eslint/",
    "lint:baseline": "eslint . --suppress-all",
    "test": "npm --workspace @voice-room/shared run test && npm --workspace @voice-room/api run test && npm --workspace @voice-room/web run test",
    "e2e": "npm --workspace @voice-room/web run e2e",
    "coverage:g08": "node scripts/coverage/run-g08.mts"
  },
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": "24.18.0",
    "npm": "11.16.0"
  },
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "eslint-plugin-svelte": "^3.23.0",
    "globals": "^17.12.0",
    "typescript-eslint": "^8.70.1"
  }
}
