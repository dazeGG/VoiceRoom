{
  # A deploy waits for Caddy to stop; open WebSockets reconnect on their own.
  grace_period 2s
  # Runtime proxy errors must not retain credential-bearing URLs or headers.
  log default {
    format filter {
      wrap json
      fields {
        request>uri delete
        request>headers delete
        request>remote_ip delete
        request>client_ip delete
        request>remote_port delete
        resp_headers delete
      }
    }
  }
  # TURN/TLS routing on :443, present only when TURN_ENABLED=true
  # (config/caddy/entrypoint.sh copies the snippets into turn.d).
  import /etc/caddy/turn.d/*.options
}

import /etc/caddy/turn.d/*.site

# Extra sites managed on the host (config/caddy/sites.d, docs/SELF_HOSTING.md);
# empty by default.
import /etc/caddy/sites.d/*.caddy

(voice_web_headers) {
  encode zstd gzip

  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    # The full policy (the policy of this exact build, connect-src narrowed
    # to LIVEKIT_DOMAIN) is generated when the image is built.
    import /etc/caddy/csp.caddy
    Cross-Origin-Opener-Policy "same-origin"
    X-Frame-Options "DENY"
    X-Content-Type-Options "nosniff"
    Referrer-Policy "same-origin"
    Permissions-Policy "microphone=(self), display-capture=(self), camera=(self), geolocation=(), payment=()"
  }

  @immutable path /_app/immutable/* /assets/* /_astro/*
  @public_immutable {
    path /_app/immutable/* /assets/* /_astro/*
    not path /_app/immutable/widget/*
  }
  # The audio files joining a call needs: fixed names, a content hash in the query.
  @versioned_audio {
    path /rnnoise/* /audio-gate.worklet.js /desktop-audio-source.worklet.js
    query v=*
  }
  # Emoji artwork, named by code point from a pinned package. A picker shows
  # hundreds at a time, so asking about each one is not free; a package upgrade
  # reaches returning visitors within this month.
  @emoji path /emoji/*
  @web_fallback {
    not path /api/* /_app/immutable/* /assets/* /_astro/* /emoji/*
    not {
      path /rnnoise/* /audio-gate.worklet.js /desktop-audio-source.worklet.js
      query v=*
    }
  }
  header @immutable Cache-Control "public, max-age=31536000, immutable"
  # Preserve the public asset headers, including dependencies of old widget loaders.
  # The current loader is self-contained and the frame's chunks are same-origin.
  header @public_immutable Access-Control-Allow-Origin "*"
  header @public_immutable Cross-Origin-Resource-Policy "cross-origin"
  header @versioned_audio Cache-Control "public, max-age=31536000, immutable"
  header @emoji Cache-Control "public, max-age=2592000"
  header @web_fallback Cache-Control "no-cache"
}

(voice_runtime_config) {
  handle /runtime-config.json {
    header Content-Type "application/json; charset=utf-8"
    header Cache-Control "no-store"
    respond `{"contractVersion":"voice-room.runtime-config/v1","schemaVersion":1,"livekit":{"wsUrl":"{$LIVEKIT_GATE_PUBLIC_URL}","connectFallbacks":[]}}` 200
  }
}

(voice_widget_entry_only) {
  # Only the compact guest entry may be framed by external HTTPS hosts.
  @widget_embed path /embed/v1 /embed/v1/ /embed/v1/index.html
  handle @widget_embed {
    header {
      defer
      -X-Frame-Options
      import {$WIDGET_POLICY:/etc/caddy/widget-csp.caddy}
      Permissions-Policy "microphone=(self), camera=(self), display-capture=(), geolocation=(), payment=()"
      Cache-Control "no-cache"
      X-Robots-Tag "noindex"
    }
    root * {$WIDGET_RELEASE_DIR:/srv/web}
    rewrite * /embed/v1/index.html
    file_server {
      precompressed br gzip
    }
  }

  handle /widget/v1/loader.js {
    header Cache-Control "no-cache"
    header Cross-Origin-Resource-Policy "cross-origin"
    header Access-Control-Allow-Origin "*"
    root * {$WIDGET_RELEASE_DIR:/srv/web}
    file_server {
      precompressed br gzip
    }
  }
}

(voice_android_links) {
  # Both the old and new app origins may be verified by the native client.
  @assetlinks {
    path /.well-known/assetlinks.json
    expression `'{$ANDROID_RELEASE_CERT_SHA256}'.matches('^([0-9A-F]{2}:){31}[0-9A-F]{2}$')`
  }
  handle @assetlinks {
    header Content-Type "application/json"
    respond `[{"relation":["delegate_permission/common.handle_all_urls"],"target":{"namespace":"android_app","package_name":"voiceroom.app","sha256_cert_fingerprints":["{$ANDROID_RELEASE_CERT_SHA256}"]}}]` 200
  }
  @assetlinks_missing path /.well-known/assetlinks.json
  handle @assetlinks_missing {
    respond 404
  }
}

(voice_web_api) {

  @api_metrics_allowed {
    path /api/metrics
    remote_ip {$API_METRICS_ALLOWED_REMOTE:127.0.0.1}
  }
  handle @api_metrics_allowed {
    reverse_proxy api:3000 {
      import /etc/caddy/proxy.d/*.caddy
    }
  }

  @api_metrics path /api/metrics
  handle @api_metrics {
    respond 404
  }

  # The admin API and the admin app's session answer only on ADMIN_DOMAIN; here
  # the main site only says who is staff and hands the session over.
  @admin_only path /api/admin/* /api/staff/check /api/staff/callback /api/staff/denied /api/staff/me /api/staff/logout /api/staff/members /api/staff/role
  handle @admin_only {
    respond 404
  }

  handle /api/* {
    reverse_proxy api:3000 {
      import /etc/caddy/proxy.d/*.caddy
      flush_interval -1
    }
  }
}

(voice_web_chunks) {
  # Separate builds share the original URL namespace. The widget-specific
  # path keeps its existing no-CORS policy, including archived frame chunks.
  handle /_app/immutable/widget/* {
    route {
      file_server {
        root {$WIDGET_RELEASE_DIR:/srv/web}
        precompressed br gzip
        pass_thru
      }
      file_server {
        root /srv/static/widget/archive
        precompressed br gzip
        pass_thru
      }
      file_server {
        root /srv/archive
        precompressed br gzip
      }
    }
  }
  handle /_app/immutable/* {
    route {
      file_server {
        root /srv/archive
        precompressed br gzip
        pass_thru
      }
      # A frozen loader from before the widget-specific path can still import
      # its public, hashed dependency.
      file_server {
        root /srv/static/widget/archive
        precompressed br gzip
      }
    }
  }

  @versioned_voice {
    path /audio-gate.worklet.js /desktop-audio-source.worklet.js /rnnoise/rnnoise.mjs /rnnoise/rnnoise.wasm /rnnoise/rnnoise.worklet.js
    expression `{query.v}.matches('^[a-f0-9]{12}$')`
  }
  handle @versioned_voice {
    route {
      rewrite * /_voice/{query.v}{path}
      file_server {
        root /srv/archive
        precompressed br gzip
        pass_thru
      }
      file_server {
        root /srv/static/widget/archive
        precompressed br gzip
        pass_thru
      }
      # Older full-stack installs served these from the web root for any v.
      rewrite * {orig_path}
      file_server {
        root /srv/web
        precompressed br gzip
      }
    }
  }
}

(voice_web_files) {
  root * /srv/web
  file_server {
    precompressed br gzip
  }
}

import /etc/caddy/domains.d/*.caddy

{$SITE_SCHEME}{$DOMAIN} {
  import voice_web_headers
  import voice_runtime_config
  import voice_widget_entry_only
  import voice_android_links
  import voice_web_api
  import voice_web_chunks

  # Legacy pages remain crawlable so crawlers see the noindex response.
  @app_private path /app /app/ /r/* /login /login/ /register /register/
  header @app_private X-Robots-Tag "noindex"
  @foreign_host not host {$CANONICAL_HOST:voiceroom.ru}
  header @foreign_host X-Robots-Tag "noindex"

  # Released Electron clients trust the original origin. Leave their legacy
  # navigations on it while redirecting ordinary browser links.
  @legacy_app_variant {
    path /app /app/ /r/* /login /login/ /register /register/
    expression `"{$APP_DOMAIN:}" != ""`
  }
  header @legacy_app_variant +Vary User-Agent
  @legacy_app_page {
    path /app /app/ /r/* /login /login/ /register /register/
    expression `"{$APP_DOMAIN:}" != ""`
    not header_regexp User-Agent `(?i)\bElectron/`
  }
  redir @legacy_app_page https://{$APP_DOMAIN:}{uri} 302
  @to_app_query {
    path /
    expression `{http.request.uri.query}.matches("(^|&)(dm|room|message|auth)=")`
  }
  @to_app_session {
    path /
    header_regexp Cookie `(?:^|[;\s])vr_session=[^;\s]`
  }
  redir @to_app_query /app?{query} 302
  redir @to_app_session /app 302

  @old_widget_docs {
    path /widgets/docs /widgets/docs/
    expression `"{$DOCS_DOMAIN:}" != ""`
  }
  redir @old_widget_docs https://{$DOCS_DOMAIN:}/widgets/install 308
  @old_docs_home {
    path /docs /docs/
    expression `"{$DOCS_DOMAIN:}" != ""`
  }
  redir @old_docs_home https://{$DOCS_DOMAIN:}/ 308
  @old_doc_subpage {
    path /docs/*
    expression `"{$DOCS_DOMAIN:}" != ""`
  }
  handle @old_doc_subpage {
    route {
      uri strip_prefix /docs
      redir https://{$DOCS_DOMAIN:}{uri} 308
    }
  }

  # Prefer the public widget configurator once the site has published it.
  @site_widget {
    path /widgets /widgets/
    file {
      root /srv/static/site/current
      try_files /widgets.html
    }
  }
  handle @site_widget {
    root * /srv/static/site/current
    rewrite * {file_match.relative}
    file_server
  }

  # The app's addresses (apps/web/src/router.ts) answer with its page. The
  # build's .br and .gz (precompressPlugin) when there are any; encode above
  # compresses the rest on the fly.
  @app_page path /app /app/ /r/* /login /login/ /register /register/ /privacy /terms /licenses /widgets /widgets/
  handle @app_page {
    root * /srv/web
    rewrite * /index.html
    file_server {
      precompressed br gzip
    }
  }

  # The public site (apps/site): `/` is its index.html, /download its download.html.
  # Its 404 and index pages have no address of their own.
  @site_file {
    not path /404 /404.html /index /index.html
    file {
      root /srv/static/site/current
      try_files {path} {path}.html {path}index.html
    }
  }
  handle @site_file {
    root * /srv/static/site/current
    rewrite * {file_match.relative}
    file_server
  }

  # A new self-hosted instance can run rooms before publishing its site.
  @empty_site_home {
    path /
    not file {
      root /srv/static/site/current
      try_files /index.html
    }
  }
  handle @empty_site_home {
    redir /app 302
  }

  # Anything else is a file of the app's build (the service worker, icons,
  # worklets) or does not exist.
  handle {
    import voice_web_files
  }

  # A missing page answers with the site's 404 page. A missing script, style,
  # chunk or API path stays a bare 404, so the app reloads instead of running HTML.
  handle_errors 404 {
    @missing_page not path /api/* /_app/* /_astro/* *.js *.mjs *.css *.json *.wasm *.map *.woff2
    handle @missing_page {
      root * /srv/static/site/current
      rewrite * /404.html
      file_server {
        status 404
      }
    }
  }
}

# The admin app. Nothing here is served to someone who is not staff: Caddy asks
# the API (forward_auth) before every file, and a browser without an admin
# session is sent through the handoff on the main site, coming back signed in
# or to a 404. The API checks the same session again on every request.
{$SITE_SCHEME}{$ADMIN_DOMAIN} {
  encode zstd gzip

  # Deferred so they replace what the API sends: its main-site policy would
  # otherwise stand next to this one and block the admin pages' inline styles.
  header {
    defer
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    import {$ADMIN_POLICY:/etc/caddy/admin-csp.caddy}
    Cross-Origin-Opener-Policy "same-origin"
    X-Frame-Options "DENY"
    X-Content-Type-Options "nosniff"
    Referrer-Policy "same-origin"
    X-Robots-Tag "noindex, nofollow"
    Permissions-Policy "microphone=(), camera=(), display-capture=(), geolocation=(), payment=()"
  }

  # The session and the staff list; the API decides on each. Handing a session
  # over belongs to the main site.
  @site_only path /api/staff/access /api/staff/handoff
  handle @site_only {
    respond 404
  }

  handle /api/staff/* {
    reverse_proxy api:3000 {
      import /etc/caddy/proxy.d/*.caddy
    }
  }

  handle /api/admin/* {
    reverse_proxy api:3000 {
      import /etc/caddy/proxy.d/*.caddy
    }
  }

  # What the panel shows of accounts: their marks and avatars.
  @admin_reads path /api/badges /api/avatars/*
  handle @admin_reads {
    reverse_proxy api:3000 {
      import /etc/caddy/proxy.d/*.caddy
    }
  }

  handle /api/* {
    respond 404
  }

  # `route` keeps the written order: the staff check sees the address as asked
  # (so a deep link survives the handoff), before try_files rewrites it, and
  # the cache headers go only on what the check let through.
  # Hashed bundles stay; a missing one is a 404, never the page as a script.
  handle /assets/* {
    route {
      forward_auth api:3000 {
        import /etc/caddy/proxy.d/*.caddy
        uri /api/staff/check
      }
      header {
        Cache-Control "private, max-age=31536000, immutable"
        match status 200
      }
      file_server {
        root {$ADMIN_RELEASE_DIR:/srv/admin}
        pass_thru
      }
      file_server {
        root /srv/static/admin/archive
      }
    }
  }

  # The page itself is asked for every time.
  handle {
    route {
      forward_auth api:3000 {
        import /etc/caddy/proxy.d/*.caddy
        uri /api/staff/check
      }
      header Cache-Control "no-cache"
      root * {$ADMIN_RELEASE_DIR:/srv/admin}
      try_files {path} /index.html
      file_server {
        hide csp.caddy
      }
    }
  }
}

{$SITE_SCHEME}{$LIVEKIT_DOMAIN} {
  respond /metrics 404
  # Signaling is a WebSocket tunnel; compressing it only adds latency.
  reverse_proxy livekit-gate:3080 {
    import /etc/caddy/proxy.d/*.caddy
  }

  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    X-Content-Type-Options "nosniff"
    Referrer-Policy "same-origin"
  }
}
