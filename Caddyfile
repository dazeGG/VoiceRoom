{$DOMAIN} {
  encode zstd gzip

  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    Content-Security-Policy "frame-ancestors 'none'"
    Cross-Origin-Opener-Policy "same-origin"
    X-Content-Type-Options "nosniff"
    Referrer-Policy "same-origin"
    Permissions-Policy "microphone=(self), display-capture=(self), camera=(), geolocation=(), payment=()"
  }

  @immutable path /_app/immutable/* /assets/*
  @web_fallback {
    not path /api/* /_app/immutable/* /assets/*
  }
  header @immutable Cache-Control "public, max-age=31536000, immutable"
  header @web_fallback Cache-Control "no-cache"

  handle /runtime-config.json {
    header Content-Type "application/json; charset=utf-8"
    header Cache-Control "no-store"
    respond `{"contractVersion":"voice-room.runtime-config/v1","schemaVersion":1,"livekit":{"wsUrl":"{$LIVEKIT_GATE_PUBLIC_URL}","connectFallbacks":[]}}` 200
  }

  @api_metrics_allowed {
    path /api/metrics
    remote_ip {$API_METRICS_ALLOWED_REMOTE:127.0.0.1}
  }
  handle @api_metrics_allowed {
    reverse_proxy api:3000
  }

  @api_metrics path /api/metrics
  handle @api_metrics {
    respond 404
  }

  handle /api/* {
    reverse_proxy api:3000 {
      flush_interval -1
    }
  }

  handle {
    root * /srv/web
    try_files {path} /index.html
    file_server
  }
}

{$LIVEKIT_DOMAIN} {
  encode zstd gzip
  reverse_proxy livekit-gate:3080

  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    X-Content-Type-Options "nosniff"
    Referrer-Policy "same-origin"
  }
}
