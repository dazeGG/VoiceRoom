{
  # A deploy waits for Caddy to stop; open WebSockets reconnect on their own.
  grace_period 2s
  # TURN/TLS routing on :443, present only when TURN_ENABLED=true
  # (config/caddy/entrypoint.sh copies the snippets into turn.d).
  import /etc/caddy/turn.d/*.options
}

import /etc/caddy/turn.d/*.site

{$DOMAIN} {
  encode zstd gzip

  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    # The full policy (the policy of this exact build, connect-src narrowed
    # to LIVEKIT_DOMAIN) is generated when the image is built.
    import /etc/caddy/csp.caddy
    Cross-Origin-Opener-Policy "same-origin"
    X-Frame-Options "DENY"
    X-Content-Type-Options "nosniff"
    Referrer-Policy "same-origin"
    Permissions-Policy "microphone=(self), display-capture=(self), camera=(self), geolocation=(), payment=()"
  }

  @immutable path /_app/immutable/* /assets/*
  @web_fallback {
    not path /api/* /_app/immutable/* /assets/*
  }
  header @immutable Cache-Control "public, max-age=31536000, immutable"
  header @web_fallback Cache-Control "no-cache"

  handle /runtime-config.json {
    header Content-Type "application/json; charset=utf-8"
    header Cache-Control "no-store"
    respond `{"contractVersion":"voice-room.runtime-config/v1","schemaVersion":1,"livekit":{"wsUrl":"{$LIVEKIT_GATE_PUBLIC_URL}","connectFallbacks":[]}}` 200
  }

  # Android App Links for the RuStore app (package voiceroom.app). Only a
  # well-formed signing key fingerprint is published; otherwise the file is a
  # 404, never the web page. Both matchers are named so they keep this order.
  @assetlinks {
    path /.well-known/assetlinks.json
    expression `'{$ANDROID_RELEASE_CERT_SHA256}'.matches('^([0-9A-F]{2}:){31}[0-9A-F]{2}$')`
  }
  handle @assetlinks {
    header Content-Type "application/json"
    respond `[{"relation":["delegate_permission/common.handle_all_urls"],"target":{"namespace":"android_app","package_name":"voiceroom.app","sha256_cert_fingerprints":["{$ANDROID_RELEASE_CERT_SHA256}"]}}]` 200
  }
  @assetlinks_missing path /.well-known/assetlinks.json
  handle @assetlinks_missing {
    respond 404
  }

  @api_metrics_allowed {
    path /api/metrics
    remote_ip {$API_METRICS_ALLOWED_REMOTE:127.0.0.1}
  }
  handle @api_metrics_allowed {
    reverse_proxy api:3000
  }

  @api_metrics path /api/metrics
  handle @api_metrics {
    respond 404
  }

  # The admin API and the admin app's session answer only on ADMIN_DOMAIN; here
  # the main site only says who is staff and hands the session over.
  @admin_only path /api/admin/* /api/staff/check /api/staff/callback /api/staff/denied /api/staff/me /api/staff/logout /api/staff/members /api/staff/role
  handle @admin_only {
    respond 404
  }

  handle /api/* {
    reverse_proxy api:3000 {
      flush_interval -1
    }
  }

  # This release's chunks and those of earlier ones still running in open tabs
  # (config/caddy/archive-assets.sh). A missing chunk is a 404, never
  # index.html, so the client reloads instead of running HTML as a script.
  handle /_app/immutable/* {
    root * /srv/archive
    file_server
  }

  handle {
    root * /srv/web
    try_files {path} /index.html
    file_server
  }
}

# The admin app. Nothing here is served to someone who is not staff: Caddy asks
# the API (forward_auth) before every file, and a browser without an admin
# session is sent through the handoff on the main site, coming back signed in
# or to a 404. The API checks the same session again on every request.
{$ADMIN_DOMAIN} {
  encode zstd gzip

  # Deferred so they replace what the API sends: its main-site policy would
  # otherwise stand next to this one and block the admin pages' inline styles.
  header {
    defer
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    import /etc/caddy/admin-csp.caddy
    Cross-Origin-Opener-Policy "same-origin"
    X-Frame-Options "DENY"
    X-Content-Type-Options "nosniff"
    Referrer-Policy "same-origin"
    X-Robots-Tag "noindex, nofollow"
    Permissions-Policy "microphone=(), camera=(), display-capture=(), geolocation=(), payment=()"
  }

  # The session and the staff list; the API decides on each. Handing a session
  # over belongs to the main site.
  @site_only path /api/staff/access /api/staff/handoff
  handle @site_only {
    respond 404
  }

  handle /api/staff/* {
    reverse_proxy api:3000
  }

  handle /api/admin/* {
    reverse_proxy api:3000
  }

  # What the panel shows of accounts: their marks and avatars.
  @admin_reads path /api/badges /api/avatars/*
  handle @admin_reads {
    reverse_proxy api:3000
  }

  handle /api/* {
    respond 404
  }

  # `route` keeps the written order: the staff check sees the address as asked
  # (so a deep link survives the handoff), before try_files rewrites it, and
  # the cache headers go only on what the check let through.
  # Hashed bundles stay; a missing one is a 404, never the page as a script.
  handle /assets/* {
    route {
      forward_auth api:3000 {
        uri /api/staff/check
      }
      header {
        Cache-Control "private, max-age=31536000, immutable"
        match status 200
      }
      root * /srv/admin
      file_server
    }
  }

  # The page itself is asked for every time.
  handle {
    route {
      forward_auth api:3000 {
        uri /api/staff/check
      }
      header Cache-Control "no-cache"
      root * /srv/admin
      try_files {path} /index.html
      file_server
    }
  }
}

{$LIVEKIT_DOMAIN} {
  # Signaling is a WebSocket tunnel; compressing it only adds latency.
  reverse_proxy livekit-gate:3080

  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    X-Content-Type-Options "nosniff"
    Referrer-Policy "same-origin"
  }
}
