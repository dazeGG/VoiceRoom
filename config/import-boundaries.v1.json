{
  "schemaVersion": 1,
  "release": "2.5.0",
  "importRules": [
    {
      "id": "no-shared-src-deep-imports",
      "sources": ["apps/api/src/**/*.js", "apps/web/src/**/*.{js,ts,svelte}"],
      "forbidden": ["packages/shared/src/", "@voice-room/shared/src/"],
      "message": "Use @voice-room/shared package exports instead of shared src deep imports."
    },
    {
      "id": "api-routes-do-not-import-db",
      "sources": ["apps/api/src/server.js", "apps/api/src/app.js"],
      "forbidden": ["./lib/db", "./lib/db.js", "apps/api/src/lib/db.js"],
      "message": "API composition must use stores instead of importing DB internals."
    }
  ],
  "writeRules": {
    "allowedOwners": {
      "rooms": ["apps/api/src/lib/room-store.js"],
      "room_memberships": ["apps/api/src/lib/room-store.js"],
      "room_bookmarks": ["apps/api/src/lib/room-store.js"],
      "room_peer_identities": ["apps/api/src/lib/room-store.js"],
      "room_messages": ["apps/api/src/lib/room-store.js"],
      "room_bans": ["apps/api/src/lib/room-store.js"],
      "room_chat_reads": ["apps/api/src/lib/room-store.js"],
      "users": ["apps/api/src/lib/user-store.js", "apps/api/src/lib/notification-store.js"],
      "sessions": ["apps/api/src/lib/user-store.js"],
      "friend_requests": ["apps/api/src/lib/friend-store.js"],
      "friendships": ["apps/api/src/lib/friend-store.js"],
      "direct_messages": ["apps/api/src/lib/friend-store.js"],
      "notification_preferences": ["apps/api/src/lib/notification-store.js"],
      "notification_dm_mutes": ["apps/api/src/lib/notification-store.js"],
      "notification_room_mutes": ["apps/api/src/lib/notification-store.js"],
      "push_subscriptions": ["apps/api/src/lib/push-store.js", "apps/api/src/lib/user-store.js"]
    },
    "ownerPathPrefixes": ["apps/api/src/migrations/"]
  },
  "timerRules": {
    "forbiddenSources": ["apps/api/src/app.js", "apps/api/src/workers/**/*.js"],
    "allowedCurrentSources": ["apps/api/src/server.js", "apps/api/src/lib/listen.js"]
  }
}
