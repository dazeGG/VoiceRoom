{
	grace_period 2s
	# Access logging stays off. Runtime errors can also include the request, so
	# remove it at the logger instead of relying on query or header names.
	log default {
		format filter {
			wrap json
			fields {
				request delete
				resp_headers delete
			}
		}
	}
}

{$PERSONAL_CADDY_SITE} {
	@api path /api /api/*
	handle @api {
		reverse_proxy api:3000 {
			# Native browser WebSocket handshakes may carry ambient cookies.
			header_up -Cookie
		}
	}

	@signal path /rtc /rtc/*
	handle @signal {
		reverse_proxy livekit-gate:3080 {
			header_up -Cookie
			# The standalone gate's cross-origin validation response is unnecessary
			# on the same-origin personal site.
			header_down -Access-Control-Allow-Origin
		}
	}

	handle /runtime-config.json {
		header Content-Type "application/json; charset=utf-8"
		header Cache-Control "no-store"
		respond `{"contractVersion":"voice-room.runtime-config/v1","schemaVersion":1,"livekit":{"wsUrl":"{$PERSONAL_SIGNAL_URL}","connectFallbacks":[]}}` 200
	}

	handle {
		root * /srv/meet
		header {
			import /etc/caddy/personal-csp.caddy
			Strict-Transport-Security "max-age=31536000"
			Cross-Origin-Opener-Policy "same-origin"
			Cross-Origin-Resource-Policy "same-origin"
			X-Frame-Options "DENY"
			X-Content-Type-Options "nosniff"
			Referrer-Policy "no-referrer"
			Permissions-Policy "microphone=(self), camera=(self), display-capture=(self), geolocation=(), payment=()"
		}
		@room path /room/*
		rewrite @room /index.html

		@immutable path /_meet/immutable/*
		@versionedAudio {
			path /rnnoise/* /audio-gate.worklet.js /desktop-audio-source.worklet.js
			query v=*
		}
		@revalidate {
			not path /_meet/immutable/*
			not {
				path /rnnoise/* /audio-gate.worklet.js /desktop-audio-source.worklet.js
				query v=*
			}
		}
		header @immutable Cache-Control "public, max-age=31536000, immutable"
		header @versionedAudio Cache-Control "public, max-age=31536000, immutable"
		header @revalidate Cache-Control "no-cache"
		file_server
	}
}
