{
  "schemaVersion": 1,
  "release": "2.5.0",
  "repository": "dazeGG/VoiceRoom",
  "source": "https://github.com/dazeGG/VoiceRoom",
  "evidencePackage": "ghcr.io/dazegg/voiceroom-release-evidence",
  "runtimePackages": [
    {
      "id": "api",
      "image": "ghcr.io/dazegg/voiceroom-api",
      "dockerTarget": "api",
      "composeVariable": "VOICEROOM_API_IMAGE"
    },
    {
      "id": "web",
      "image": "ghcr.io/dazegg/voiceroom-web",
      "dockerTarget": "web",
      "composeVariable": "VOICEROOM_WEB_IMAGE"
    },
    {
      "id": "worker",
      "image": "ghcr.io/dazegg/voiceroom-worker",
      "dockerTarget": "worker",
      "composeVariable": "VOICEROOM_WORKER_IMAGE"
    },
    {
      "id": "musicbot",
      "image": "ghcr.io/dazegg/voiceroom-musicbot",
      "dockerTarget": "musicbot",
      "composeVariable": "VOICEROOM_MUSICBOT_IMAGE"
    }
  ],
  "requirements": {
    "immutableDigestOnly": true,
    "sbomRequired": true,
    "provenanceRequired": true,
    "deploymentHostBuildAllowed": false,
    "mustNotUseEvidencePackage": true
  },
  "nonProductionEnvironments": [
    "release-candidate",
    "staging"
  ]
}
