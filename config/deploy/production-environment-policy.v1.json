{
  "schemaVersion": 1,
  "release": "2.5.0",
  "repository": {
    "owner": "dazeGG",
    "name": "VoiceRoom",
    "fullName": "dazeGG/VoiceRoom"
  },
  "environment": "production",
  "workflowPath": ".github/workflows/promote-production-digests.yml",
  "requiredTag": "v2.5.0",
  "defaultStatus": "PROMOTION_DISABLED_EXTERNAL_AUTHORITY",
