  },
  "promotionPermissions": {
    "contents": "read",
    "packages": "read",
    "deployments": "write",
    "id-token": "none"
  },
  "environmentPolicy": {
    "protected_branches": false,
    "custom_branch_policies": true,
    "selectedTag": "v2.5.0",
    "prevent_self_review": true,
    "can_admins_bypass": false
  },
  "allowLivePromotionInThisRelease": false
