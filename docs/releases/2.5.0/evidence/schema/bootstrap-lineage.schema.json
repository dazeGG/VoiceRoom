{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "ancestors": {
      "type": "array"
    },
    "release": {
      "const": "2.5.0"
    },
    "schemaVersion": {
      "const": 1
    },
    "selectedAttemptId": {
      "type": "string"
    },
    "terminalDevelopSha": {
      "pattern": "^[0-9a-f]{40}$",
      "type": "string"
    }
  },
  "required": [
    "schemaVersion",
    "release",
    "selectedAttemptId",
    "terminalDevelopSha",
    "ancestors"
  ],
  "type": "object"
}
