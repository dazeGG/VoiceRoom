{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "attemptId": {
      "pattern": "^g01-recovery-a[0-9]{2,}$",
      "type": "string"
    },
    "baseSha": {
      "pattern": "^[0-9a-f]{40}$",
      "type": "string"
    },
    "branch": {
      "pattern": "^feature/2\\.5\\.0-g01-postmerge-bootstrap-a[0-9]{2,}$",
      "type": "string"
    },
    "headSha": {
      "pattern": "^[0-9a-f]{40}$",
      "type": "string"
    },
    "parentSha": {
      "pattern": "^[0-9a-f]{40}$",
      "type": "string"
    },
    "authorityDigest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "planSpecPairDigest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "firstAuthoritativeId": {
      "oneOf": [
        { "minLength": 1, "type": "string" },
        { "minimum": 1, "type": "integer" }
      ]
    },
    "priorFailureId": {
      "pattern": "^bootstrap-failure\\.g01-(a|recovery-a)[0-9]{2,}\\.json$",
      "type": "string"
    },
    "priorFailureDigest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    }
  },
  "required": [
    "attemptId",
    "branch",
    "baseSha",
    "parentSha",
    "headSha",
    "authorityDigest",
    "planSpecPairDigest",
    "firstAuthoritativeId",
    "priorFailureId",
    "priorFailureDigest"
  ],
  "type": "object"
}
