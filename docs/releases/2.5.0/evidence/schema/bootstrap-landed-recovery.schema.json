{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "attemptId": {
      "pattern": "^g01-recovery-a[0-9]{2,}$",
      "type": "string"
    },
    "baseSha": {
      "pattern": "^[0-9a-f]{40}$",
      "type": "string"
    },
    "branch": {
      "pattern": "^feature/2\\.5\\.0-g01-postmerge-bootstrap-a[0-9]{2,}$",
      "type": "string"
    },
    "headSha": {
      "pattern": "^[0-9a-f]{40}$",
      "type": "string"
    },
    "priorFailureDigest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    }
  },
  "required": [
    "attemptId",
    "branch",
    "baseSha",
    "headSha",
    "priorFailureDigest"
  ],
  "type": "object"
}
