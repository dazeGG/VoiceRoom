{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": { "properties": { "phase": { "const": "F7" } }, "required": ["phase"] },
      "then": {
        "properties": {
          "f7Digest": false,
          "f9Digest": false,
          "mergeSha": false,
          "mergedAt": false,
          "remoteDeleted": false,
          "remoteDeletionObservedAt": false,
          "terminalDevelopSha": false
        }
      }
    },
    {
      "if": { "properties": { "phase": { "const": "F9" } }, "required": ["phase"] },
      "then": {
        "properties": {
          "f9Digest": false,
          "mergeSha": false,
          "mergedAt": false,
          "remoteDeleted": false,
          "remoteDeletionObservedAt": false,
          "terminalDevelopSha": false
        },
        "required": ["f7Digest"]
      }
    },
    {
      "if": { "properties": { "phase": { "const": "F11" } }, "required": ["phase"] },
      "then": {
        "properties": { "remoteDeleted": { "const": true } },
        "required": ["f7Digest", "f9Digest", "mergeSha", "terminalDevelopSha", "remoteDeleted", "mergedAt", "remoteDeletionObservedAt"]
      }
    }
  ],
  "properties": {
    "createdAt": { "format": "date-time", "type": "string" },
    "digest": { "pattern": "^sha256:[0-9a-f]{64}$", "type": "string" },
    "evidenceId": { "pattern": "^(ci-bundle|approval-envelope|merge-envelope)\\.(g01|bootstrap-recovery-a[0-9]{2,})\\.json$", "type": "string" },
    "f7Digest": { "pattern": "^sha256:[0-9a-f]{64}$", "type": "string" },
    "f9Digest": { "pattern": "^sha256:[0-9a-f]{64}$", "type": "string" },
    "goal": { "const": "G01" },
    "mergedAt": { "format": "date-time", "type": "string" },
    "mergeSha": { "pattern": "^[0-9a-f]{40}$", "type": "string" },
    "phase": { "enum": ["F7", "F9", "F11"] },
    "remoteDeleted": { "type": "boolean" },
    "remoteDeletionObservedAt": { "format": "date-time", "type": "string" },
    "schemaVersion": { "const": 1 },
    "sourceSha": { "pattern": "^[0-9a-f]{40}$", "type": "string" },
    "status": { "enum": ["GREEN", "RED"] },
    "terminalDevelopSha": { "pattern": "^[0-9a-f]{40}$", "type": "string" }
  },
  "required": ["schemaVersion", "goal", "phase", "status", "evidenceId", "sourceSha", "digest", "createdAt"],
  "type": "object"
}
