{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "architect": {
      "const": "APPROVE"
    },
    "authorizationDigest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "critic": {
      "const": "APPROVE"
    },
    "planner": {
      "const": "APPROVE"
    },
    "schemaVersion": {
      "const": 1
    }
  },
  "required": [
    "schemaVersion",
    "authorizationDigest",
    "planner",
    "architect",
    "critic"
  ],
  "type": "object"
}
