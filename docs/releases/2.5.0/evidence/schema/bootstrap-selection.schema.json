{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "ancestorFailures": {
      "type": "array"
    },
    "attemptId": {
      "type": "string"
    },
    "bootstrapSupersessionChainDigest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "f11Digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "f7Digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "f9Digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "release": {
      "const": "2.5.0"
    },
    "remoteDeleted": {
      "const": true
    },
    "schemaVersion": {
      "const": 1
    },
    "status": {
      "const": "SELECTED_GREEN"
    },
    "terminalDevelopSha": {
      "pattern": "^[0-9a-f]{40}$",
      "type": "string"
    },
    "terminalKind": {
      "enum": [
        "DIRECT_CANONICAL",
        "LANDED_RECOVERY"
      ]
    }
  },
  "required": [
    "schemaVersion",
    "release",
    "attemptId",
    "terminalKind",
    "f7Digest",
    "f9Digest",
    "f11Digest",
    "terminalDevelopSha",
    "remoteDeleted",
    "status",
    "bootstrapSupersessionChainDigest"
  ],
  "type": "object"
}
