{
  "name": "@voice-room/web",
  "version": "2.5.3",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "predev": "npm run emoji:assets",
    "build": "vite build",
    "prebuild": "npm run emoji:assets",
    "emoji:assets": "node scripts/build-emoji-assets.mjs",
    "check": "node --check static/audio-gate.worklet.js && node --check static/desktop-audio-source.worklet.js && node --check static/rnnoise/rnnoise.worklet.js && svelte-kit sync && tsc --noEmit && svelte-check --tsconfig ./tsconfig.json",
    "preview": "vite preview",
    "test": "node --test test/*.test.js",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@fortawesome/free-brands-svg-icons": "^7.3.0",
    "@lucide/svelte": "^1.24.0",
    "@voice-room/shared": "file:../../packages/shared",
    "livekit-client": "^2.19.2",
    "svelte-fa": "^4.0.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@sveltejs/adapter-static": "^3.0.8",
    "@sveltejs/kit": "^2.0.0",
    "@twemoji/svg": "15.0.0",
    "@types/node": "^24.0.0",
    "svelte": "^5.0.0",
    "svelte-check": "^4.7.1",
    "typescript": "^5.6.0",
    "vite": "^8.0.0"
  }
}
