{
  // Tests, build scripts and config files run on Node (Vitest, Vite), so they
  // get Node's types on top of the app's settings.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "types": ["vite/client", "node"],
    "noUnusedLocals": false
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.vue",
    "test/**/*.ts",
    "test/**/*.vue",
    "e2e/**/*.ts",
    "scripts/**/*.ts",
    "playwright.config.ts",
    "vite.config.ts"
  ]
}
