{
  "name": "@voice-room/web-vue",
  "version": "2.11.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "predev": "npm run emoji:assets",
    "build": "vite build",
    "prebuild": "npm run emoji:assets",
    "emoji:assets": "node scripts/build-emoji-assets.ts",
    "check": "node --check public/audio-gate.worklet.js && node --check public/desktop-audio-source.worklet.js && node --check public/rnnoise/rnnoise.worklet.js && vue-tsc --noEmit && vue-tsc -p tsconfig.test.json --noEmit",
    "preview": "vite preview",
    "test": "vitest run",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@fortawesome/free-brands-svg-icons": "^7.3.0",
    "@lucide/vue": "^1.61.0",
    "@voice-room/shared": "file:../../packages/shared",
    "livekit-client": "^2.22.4",
    "pinia": "^4.1.0",
    "reka-ui": "^2.11.0",
    "typebox": "^1.3.34",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@discordapp/twemoji": "16.0.1",
    "@playwright/test": "^1.61.1",
    "@testing-library/user-event": "^14.6.7",
    "@testing-library/vue": "^8.1.0",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "jsdom": "^30.1.1",
    "sass": "^1.106.1",
    "typescript": "^5.6.0",
    "vite": "^8.0.0",
    "vitest": "^5.0.1",
    "vue-tsc": "^3.3.13"
  }
}
