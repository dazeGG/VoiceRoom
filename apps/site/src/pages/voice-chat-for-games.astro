---
import Cards from '../components/Cards.astro';
import Compare from '../components/Compare.astro';
import CtaBand from '../components/CtaBand.astro';
import Faq from '../components/Faq.astro';
import Hero from '../components/Hero.astro';
import Section from '../components/Section.astro';
import Base from '../layouts/Base.astro';
import { faqJsonLd, jsonLdScript, type FaqItem } from '../seo.ts';
import { PAGES, START_ROOM_HREF } from '../site.ts';

const page = PAGES.games;

const faq: FaqItem[] = [
  {
    question: 'Нужно ли друзьям ставить приложение?',
    answer:
      'Нет. Друзья могут зайти по ссылке из браузера. Приложение добавляет то, что браузер не умеет: хоткеи, когда окно не в фокусе, оверлей поверх игры и звук стрима без эха.'
  },
  {
    question: 'Работает ли оверлей в полноэкранной игре?',
    answer:
      'Оверлей работает в оконном режиме и в режиме «без рамки» (borderless). Если игра запущена в эксклюзивном полноэкранном режиме, переключите её в borderless.'
  },
  {
    question: 'Сработает ли хоткей, если в игре другая раскладка?',
    answer: 'Да. Сочетания привязаны к физическим клавишам и не зависят от раскладки.'
  },
  {
    question: 'Как убрать шум клавиатуры и вентилятора?',
    answer:
      'Включите шумоподавление и настройте порог гейта микрофона: тихие звуки ниже порога не попадут в звонок. Либо говорите по push-to-talk.'
  }
];

const jsonLd = jsonLdScript(faqJsonLd(faq));
---

<Base page={page} jsonLd={jsonLd}>
  <Hero
    kicker="Голосовой чат для игр"
    title="Голосовой чат для игр с друзьями"
    lead="Соберите пати по ссылке: друзья зайдут из браузера без регистрации, а вы — из приложения с хоткеями и оверлеем поверх игры."
    primary={{ href: START_ROOM_HREF, label: 'Создать комнату' }}
    secondary={{ href: PAGES.download.path, label: 'Скачать приложение' }}
    note="Бесплатно · Windows и macOS · друзьям хватит браузера"
  />

  <Section title="Поверх игры" lead="То, что умеет приложение VoiceRoom для Windows и macOS.">
    <Cards
      items={[
        {
          title: 'Хоткеи в свёрнутом окне',
          text: 'Мьют микрофона, мьют звука и push-to-talk срабатывают, даже когда в фокусе игра. Сочетания не зависят от раскладки.'
        },
        {
          title: 'Оверлей',
          text: 'Поверх игры видно, кто в звонке, кто говорит и кто стримит. Работает в оконном и borderless режимах.'
        },
        {
          title: 'Стрим игры со звуком',
          text: 'Звук компьютера идёт в демонстрацию без голосов собеседников, поэтому у зрителей нет эха.',
          href: PAGES.screen.path,
          link: 'Про демонстрацию экрана'
        },
        {
          title: 'Звонок в трее',
          text: 'Микрофон, звук и выход из звонка — из трея или Dock, не открывая окно.'
        },
        {
          title: 'Бережёт ресурсы',
          text: 'Пока окно свёрнуто, невидимое видео не скачивается, а во время игры анимации стоят на паузе.'
        },
        {
          title: 'Автозапуск',
          text: 'Приложение может запускаться вместе с системой — свёрнутым в трей — и обновляется само.'
        }
      ]}
    />
  </Section>

  <Section title="Голос">
    <Cards
      items={[
        {
          title: 'Шумоподавление',
          text: 'RNNoise убирает фоновый шум, а гейт микрофона с порогом не пускает в звонок тихие звуки между фразами.'
        },
        {
          title: 'Push-to-talk',
          text: 'Микрофон включается только по кнопке. Сочетания клавиш настраиваются.'
        },
        {
          title: 'Громкость каждого',
          text: 'Сделайте тихого друга громче, а громкого тише — от 0 до 200 %. Можно заглушить человека только для себя.'
        },
        {
          title: 'Связь видна',
          text: 'Пинг, потери и джиттер. Если прямое соединение не проходит, звонок идёт через ретранслятор.'
        }
      ]}
    />
  </Section>

  <Section title="Браузер или приложение">
    <Compare
      caption="Что доступно в браузере и в приложении"
      columns={['Браузер', 'Приложение']}
      rows={[
        { label: 'Голос, камера, экран и чат', cells: ['Да', 'Да'] },
        { label: 'Push-to-talk и хоткеи в открытом окне', cells: ['Да', 'Да'] },
        { label: 'Хоткеи, когда в фокусе игра', cells: ['Нет', 'Да'] },
        { label: 'Оверлей поверх игры', cells: ['Нет', 'Да'] },
        { label: 'Звук стрима без эха', cells: ['Зависит от браузера', 'Да'] },
        { label: 'Трей, автозапуск и автообновление', cells: ['Нет', 'Да'] }
      ]}
    />
  </Section>

  <Faq items={faq} />

  <CtaBand
    title="Соберите пати"
    text="Создайте комнату, отправьте ссылку в чат и заходите в игру."
    secondary={{ href: PAGES.download.path, label: 'Скачать приложение' }}
  />
</Base>
