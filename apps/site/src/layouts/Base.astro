---
// The frame of every page: what search engines and link previews read in <head>,
// the menu and the footer. Pages pass their entry from site.ts.
import '../styles/site.scss';
import Icon from '../components/Icon.astro';
import {
  APP_HREF,
  LEGAL_LINKS,
  NAV_PAGES,
  OG_IMAGE,
  PAGES,
  SELF_HOSTING_URL,
  SITEMAP_PAGES,
  SOURCE_URL,
  START_ROOM_HREF,
  canonicalUrl,
  type SitePage
} from '../site.ts';

interface Props {
  page: SitePage;
  /** JSON from seo.ts jsonLdScript(). */
  jsonLd?: string;
  /** A page that is not a search result (the 404 page): no canonical, robots noindex. */
  noindex?: boolean;
  /** The home page, which the desktop app opens: it goes on to the app there. */
  desktopRedirect?: boolean;
}

const { page, jsonLd, noindex = false, desktopRedirect = false } = Astro.props;
const canonical = canonicalUrl(page.path);
const ogImage = canonicalUrl(OG_IMAGE.path);
const current = Astro.url.pathname.replace(/\.html$/, '');
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {desktopRedirect && <script is:inline src="/desktop-redirect.js"></script>}
    <title>{page.title}</title>
    <meta name="description" content={page.description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <meta name="theme-color" content="#131416" />
    <link rel="icon" href="/voiceroom-icon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="VoiceRoom" />
    <meta property="og:locale" content="ru_RU" />
    <meta property="og:title" content={page.title} />
    <meta property="og:description" content={page.description} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content={String(OG_IMAGE.width)} />
    <meta property="og:image:height" content={String(OG_IMAGE.height)} />
    <meta name="twitter:card" content="summary_large_image" />
    {jsonLd && <script is:inline type="application/ld+json" set:html={jsonLd} />}
  </head>
  <body class="site">
    <header class="site-header">
      <div class="site-header__inner">
        <a class="site-header__brand" href={PAGES.home.path} aria-label="VoiceRoom — на главную">
          <img src="/voiceroom-icon.svg" alt="" width="28" height="28" />
          <span>VoiceRoom</span>
        </a>
        <nav class="site-header__nav" aria-label="Разделы">
          {
            NAV_PAGES.map((item) => (
              <a
                class="site-header__link"
                href={item.path}
                aria-current={current === item.path ? 'page' : undefined}
              >
                {item.nav}
              </a>
            ))
          }
        </nav>
        <a class="site-button site-button--small" href={APP_HREF}
          >Открыть<span class="site-header__app-name"> VoiceRoom</span></a
        >
        <details class="site-menu">
          <summary class="site-menu__toggle">
            <Icon name="menu" />
            <span class="visually-hidden">Меню</span>
          </summary>
          <nav class="site-menu__drawer" aria-label="Разделы">
            {
              NAV_PAGES.map((item) => (
                <a href={item.path} aria-current={current === item.path ? 'page' : undefined}>
                  {item.nav}
                </a>
              ))
            }
          </nav>
        </details>
      </div>
    </header>

    <main class="site-main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="site-footer__inner">
        <div class="site-footer__about">
          <a class="site-header__brand" href={PAGES.home.path}>
            <img src="/voiceroom-icon.svg" alt="" width="24" height="24" />
            <span>VoiceRoom</span>
          </a>
          <p>Голосовые комнаты по ссылке: голос, демонстрация экрана, камера и чат. Бесплатно.</p>
          <a class="site-button site-button--small" href={START_ROOM_HREF}>Создать комнату</a>
        </div>
        <nav class="site-footer__column" aria-label="VoiceRoom">
          <p class="site-footer__heading">VoiceRoom</p>
          {SITEMAP_PAGES.map((item) => <a href={item.path}>{item.nav}</a>)}
        </nav>
        <nav class="site-footer__column" aria-label="Проект">
          <p class="site-footer__heading">Проект</p>
          <a href={SOURCE_URL}>Исходный код на GitHub</a>
          <a href={SELF_HOSTING_URL}>Развернуть у себя</a>
          {LEGAL_LINKS.map((link) => <a href={link.href}>{link.label}</a>)}
        </nav>
      </div>
    </footer>
  </body>
</html>
