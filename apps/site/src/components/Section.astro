---
// A titled block of a page; `id` makes it linkable.
interface Props {
  title: string;
  lead?: string;
  id?: string;
}
const { title, lead, id } = Astro.props;
---

<section class="section" id={id}>
  <h2 class="section__title">{title}</h2>
  {lead && <p class="section__lead">{lead}</p>}
  <slot />
</section>
