{
  // New API code is strict TypeScript in .mts files, run by Node 24 as-is
  // (type stripping), so only erasable syntax is allowed and nothing is
  // emitted. Legacy .js stays unchecked until it is migrated; its types are
  // still inferred where .mts code imports it. See docs/ARCHITECTURE.md.
  "compilerOptions": {
    "target": "es2023",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": ["es2023"],
    "types": ["node"],
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*.mts", "test/**/*.mts"]
}
