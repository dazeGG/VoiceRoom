{
  "name": "@voice-room/api",
  "version": "2.5.7",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "check": "node ../../scripts/check-js-syntax.mjs src test/db-harness.js test/require-test-database-url.js",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "test:g05": "node --test test/g05-livekit-boundary.test.js",
    "db:migrate": "node src/scripts/migrate.js up",
    "db:rollback": "node src/scripts/migrate.js down",
    "pretest": "node test/require-test-database-url.js"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/multipart": "^10.1.0",
    "@fastify/websocket": "^11.2.0",
    "@voice-room/shared": "file:../../packages/shared",
    "fastify": "^5.8.5",
    "livekit-server-sdk": "^2.15.4",
    "node-pg-migrate": "^8.0.4",
    "pg": "^8.21.0",
    "sharp": "^0.35.3",
    "web-push": "^3.6.7"
  }
}
