{
  "name": "@voice-room/api",
  "version": "2.6.4",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "check": "node ../../scripts/check-js-syntax.mjs src test/db-harness.js test/require-test-database-url.js && tsc -p tsconfig.json",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "test:g05": "node --test test/g05-livekit-boundary.test.js",
    "db:migrate": "node src/scripts/migrate.js up",
    "db:rollback": "node src/scripts/migrate.js down",
    "pretest": "node test/require-test-database-url.js"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/multipart": "^10.1.0",
    "@fastify/websocket": "^11.2.0",
    "@voice-room/shared": "file:../../packages/shared",
    "fastify": "^5.12.5",
    "livekit-server-sdk": "^2.15.4",
    "maxmind": "^5.0.7",
    "node-pg-migrate": "^8.0.4",
    "pg": "^8.21.0",
    "pino": "^10.3.1",
    "sharp": "^0.35.4",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.3"
  }
}
